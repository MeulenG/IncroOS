<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Kernel code written in C#. This assembly never runs on .NET: IncroCompiler turns its IL
    into x86-64 that is linked into the kernel. See CMakeLists.txt next to this file.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
